<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_dark">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="@color/profile_key_function_pressed" />
                    <stroke android:width="1dp" android:color="@color/profile_key_stroke" />
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="@color/profile_key_function_hover" />
                    <stroke android:width="1dp" android:color="@color/profile_key_stroke" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="@color/profile_key_function" />
                    <stroke android:width="1dp" android:color="@color/profile_key_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

