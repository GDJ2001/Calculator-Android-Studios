<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_dark">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="@color/profile_key_operator_pressed" />
                    <stroke android:width="1dp" android:color="@color/profile_key_stroke" />
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape android:shape="oval">
                    <solid android:color="@color/profile_key_operator_hover" />
                    <stroke android:width="1dp" android:color="@color/profile_key_stroke" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/profile_key_operator" />
                    <stroke android:width="1dp" android:color="@color/profile_key_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

